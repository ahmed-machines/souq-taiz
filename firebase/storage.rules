rules_version = '2';

// Souq Taiz - Storage rules. Listing images live at
// listings/{ownerId}/{listingId}/{file}. Only the owning, active user can
// upload; type and size are enforced here in addition to client checks.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(ownerId) { return signedIn() && request.auth.uid == ownerId; }
    function isActive() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /listings/{ownerId}/{listingId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(ownerId) && isActive() && validImage();
      allow update: if false;
      allow delete: if isOwner(ownerId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
